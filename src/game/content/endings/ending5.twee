:: Ending 5
<<script>>
    UIBar.hide();
<</script>>
<<EventMessenger "showMenu" true true>>
/* passage content */
<<set $endingImage to "/img/e-violence.jpg">>
<<set $endingLabel to "The Corporate Trail - You Chose Violence">>
<div class="abs-wrapper">
    <img class="logo" src="img/logo.png"/>
	<div class="rel-wrapper">
        <div class="content content--ending">
            <<TitleBar "🔪🔪 YOU CHOSE VIOLENCE 🔪🔪">>
            <div class="ending">
                <img class="ending__img" src="img/e-violence.jpg"/>
                <div class="ending__text">
                    <h1 class="ending__title">$user,You Chose Violence</h1>
                    <p class="ending__desc">$workStyle $orientation For you to win, someone else has to lose. Call it a competitive spirit. You either played D1 athletics or too much Monopoly.</p>
                </div>
            </div>
            <<SharingModule>>
        </div>
    </div>
</div>
<<audio "tada" volume 0.25 play>>
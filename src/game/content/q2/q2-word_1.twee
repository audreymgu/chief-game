/* title + metadata */
:: Sorry I care, Brian {"position":"600,800","size":"100,100"}
<<CalcResource "1" "-1" "0" "0">>
<<audio "neutral" volume 0.5 play>>
<<set $quarterLabel to "YOU ARE IN: Q"+ $quarter>>
<<TitleBar $quarterLabel>>
<div class="scenario scenario--inactive">
    <img class="scenario__img" src="img/q2-word.jpg"/>
    <div class="scenario__text">
        <h1 class="scenario__title">The "E" Word</h1>
        <p class="scenario__desc">After passionately advocating for a project, Brian says you seem "emotional.”</p>
    </div>
</div>
<div class="alert">
    <div class="scenario scenario--alert">
        <img class="scenario__icon" src="img/warn1.png"/>
        <div class="scenario__text scenario__text--alert">
            <p class="scenario__desc scenario__desc--alert">His comment still stings, but at least you got in the last word.</p>
        </div>
    </div>
    <div class="btn-area btn-area--alert">
        <div class="button">
            <<link "Next">>
                <<EndingCheck>>
            <</link>>
        </div>
    </div>
</div>
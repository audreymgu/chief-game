/* title + metadata */
:: Leggings {"position":"600,800","size":"100,100"}
<<script>>
    UIBar.show();
    UIBar.unstow();
<</script>>
/* passage content */
<<CalcResource "-1" "0" "1" "0">>
<<audio "neutral" volume 0.5 play>>
<<set $quarterLabel to "YOU ARE IN: Q"+ $quarter>>
<<TitleBar $quarterLabel>>
<div class="scenario scenario--inactive">
	<img class="scenario__img" src="img/q1-wfh.jpg"/>
	<div class="scenario__text">
		<h1 class="scenario__title">RTOh No</h1>
		<p class="scenario__desc">The exec committee is pushing for five days in-office. It spells disaster for laundry piles everywhere.</p>
	</div>
</div>
<div class="alert">
    <div class="scenario scenario--alert">
        <img class="scenario__icon" src="img/warn1.png"/>
        <div class="scenario__text scenario__text--alert">
            <p class="scenario__desc scenario__desc--alert">Sure, you’ll miss working in your leggings, but if leadership doesn’t model this, who will?</p>
        </div>
    </div>
    <div class="btn-area btn-area--alert">
        <div class="button">
            <<link "Next">>
                <<EndingCheck>>
            <</link>>
        </div>
    </div>
</div>
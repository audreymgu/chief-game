:: Ending 8
<<script>>
    UIBar.hide();
<</script>>
<<EventMessenger "showMenu" true true>>
/* passage content */
<<set $endingImage to "/img/e-thrones.png">>
<<set $endingLabel to "got">>
<div class="abs-wrapper">
    <img class="logo" src="img/logo.png"/>
	<div class="rel-wrapper">
        <div class="content content--ending">
            <<TitleBar "👑👑 YOU GAME OF THRONES'D IT 👑👑">>
            <div class="ending">
                <img class="ending__img" src="img/e-thrones.jpg"/>
                <div class="ending__text">
                    <h1 class="ending__title">$user,You Game-of-Thrones'd It</h1>
                    <p class="ending__desc">$workStyle $orientation Your feel for office politics is as honed as it is frightening. Maybe you should look into actual politics.</p>
                    <<link "Play again?">>
                        <<script>>
                            Engine.restart();
                        <</script>>
                    <</link>>
                </div>
            </div>
            <<SharingModule>>
        </div>
    </div>
</div>
<<audio "tada" volume 0.25 play>>
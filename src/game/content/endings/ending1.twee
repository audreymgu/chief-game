:: Ending 1
<<script>>
    UIBar.hide();
<</script>>
<<EventMessenger "showMenu" true true>>
/* passage content */
<<set $endingImage to "/img/e-friends.png">>
<<set $endingLabel to "The Corporate Trail - You're Not Here to Make Friends">>
<div class="abs-wrapper">
    <img class="logo" src="img/logo.png"/>
	<div class="rel-wrapper">
        <div class="content content--ending">
            <<TitleBar "👏👏 NOT HERE TO MAKE FRIENDS 👏👏">>
            <div class="ending">
                <img class="ending__img" src="img/e-friends.jpg"/>
                <div class="ending__text">
                    <h1 class="ending__title">$user,You’re Not Here to Make Friends</h1>
                    <p class="ending__desc">$workStyle $orientation Water cooler talk was never your thing. You’d prefer coworkers not bother you, but if they must, they need to make it *actionable*.</p>
                </div>
            </div>
            <<SharingModule>>
        </div>
    </div>
</div>
<<audio "tada" volume 0.25 play>>
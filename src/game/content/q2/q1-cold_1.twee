/* title + metadata */
:: Drape yourself in blankets {"position":"600,800","size":"100,100"}
<<script>>
    UIBar.show();
    UIBar.unstow();
<</script>>
<<audio "neutral" volume 0.5 play>>
<<CalcResource "0" "0" "1" "1">>
<<set $quarterLabel to "YOU ARE IN: Q"+ $quarter>>
<<TitleBar $quarterLabel>>
<div class="scenario scenario--inactive">
    <img class="scenario__img" src="img/q1-cold.jpg"/>
    <div class="scenario__text">
        <h1 class="scenario__title">What's Cooler Than Being Cold?</h1>
        <p class="scenario__desc">The building is heated like a Victorian prison. Your besuited colleagues don’t seem to notice.</p>
    </div>
</div>
<div class="alert">
    <div class="scenario scenario--alert">
        <img class="scenario__icon" src="img/warn1.png"/>
        <div class="scenario__text scenario__text--alert">
            <p class="scenario__desc scenario__desc--alert">You look like a Nova Scotian fur trader, but at least you’re (mostly) comfortable.</p>
        </div>
    </div>
    <div class="btn-area btn-area--alert">
        <div class="button">
            <<link "Next">>
                <<EndingCheck>>
            <</link>>
        </div>
    </div>
</div>


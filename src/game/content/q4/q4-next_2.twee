/* title + metadata */
:: Conversational Approach {"position":"600,800","size":"100,100"}
<<script>>
    UIBar.show();
    UIBar.unstow();
<</script>>
<<CalcResource "0" "0" "0" "0">>
<<audio "neutral" volume 0.5 play>>
<<set $quarterLabel to "YOU ARE IN: Q"+ $quarter>>
<<TitleBar $quarterLabel>>
<div class="scenario scenario--inactive">
    <img class="scenario__img" src="img/q4-next.jpg"/>
    <div class="scenario__text">
        <h1 class="scenario__title">Next Steps</h1>
        <p class="scenario__desc">You made it to the end of the year—now it’s time to make a case for your promotion.</p>
    </div>
</div>
<div class="alert">
    <div class="scenario scenario--alert">
        <img class="scenario__icon" src="img/warn1.png"/>
        <div class="scenario__text scenario__text--alert">
            <p class="scenario__desc scenario__desc--alert">You keep things light, but by the end of the meeting, it’s clear nothing’s changing. Turns out, charm only goes so far.</p>
        </div>
    </div>
    <div class="btn-area btn-area--alert">
        <div class="button">
            <<link "Next">>
                <<EndingCheck>>
            <</link>>
        </div>
    </div>
</div>

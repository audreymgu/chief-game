:: StoryCaption [StoryInit] {"position":"500,100","size":"100,100"}

<div id="desktop" class="icon-view">
    <div id="about-btn" class="icon">
        <img class="icon__img" src="img/about.png" />
        <p class="icon__label">ABOUT</p>
    </div>
    <div id="quit-btn" class="icon">
        <img class="icon__img" src="img/quit.png" />
        <p class="icon__label">QUIT</p>
    </div>
</div>

<<done>>
    <<script>>
        $("#quit-btn").click(function() {
            $.wiki("<<timed 0.1s>><<goto 'QUIT'>><</timed>>");
        });
        $(document).ready(function() {
            $("#about-btn").click(function() {
                $.wiki("<<audio 'click' volume 1 play>>");
                document.getElementById('about').classList.toggle('about-window--hidden');
                console.log("meme");
            });
        });
    <</script>>
<</done>>
</div>

<<script>>
	function startUnlock() {
		const btn = document.querySelector('#start-btn');
		btn.classList.remove('button--disabled');
	}
	const waitForGSAP = setInterval(function() {
		if (typeof gsap !== "undefined") {
			clearInterval(waitForGSAP);
			
			gsap.from(".notification", {delay: 0.5, stagger: 1, duration: 0.5, y: 25, opacity: 0, ease: "back.out", onComplete: startUnlock});
		}
	}, 100);
<</script>>
:: QUIT [QUIT]
<<EventMessenger "showMenu" true true>>
/* passage content */
<<set $endingImage to "/img/ending1.png">>
<<set $endingLabel to "The Corporate Trail - You Chose Violence">>
<div class="abs-wrapper">
    <img class="logo" src="img/logo.png"/>
	<div class="rel-wrapper">
        <div class="content content--ending">
            <<TitleBar "🦎🦎 YOU QUIT 🦎🦎">>
            <div class="ending">
                <img class="ending__img" src="img/placeholder.png"/>
                <div class="ending__text">
                    <h1 class="ending__title">You Quit</h1>
                    <p class="ending__desc">Spend your best years saying shit like “circle back” while drinking a watery K-Cup in some anonymous conference room? No thanks. Time to abscond to Costa Rica and become an iguana tamer.</p>
                </div>
            </div>
        </div>
        <div class="btn-area">
            <div class="button">
                <<link "Play Again?">>
                    <<script>>
                        Engine.restart();
                    <</script>>
                <</link>>
            </div>
        </div>
</div>